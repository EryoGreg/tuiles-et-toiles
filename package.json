{
  "name": "tuiles-et-toiles",
  "version": "0.3.5",
  "description": "Tuiles et Toiles",
  "main": "src/main/index.js",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "node node_modules/vite/bin/vite.js build",
    "start": "node scripts/dev.js",
    "dist": "node scripts/faire-icone.js && node node_modules/vite/bin/vite.js build && node node_modules/electron-builder/out/cli/cli.js --win portable nsis",
    "polices": "node scripts/polices.js",
    "import": "node scripts/lancer-node.js src/main/import.js",
    "test": "node scripts/lancer-node.js tests/synchro-e2a.test.js && node scripts/lancer-node.js tests/synchro-e2b.test.js && node scripts/lancer-node.js tests/synchro-drive-http.test.js && node scripts/lancer-node.js tests/mobile-sqlite.test.js && node scripts/lancer-node.js tests/synchro-e2c.test.js && node scripts/lancer-node.js tests/synchro-e2d.test.js && node scripts/lancer-node.js tests/synchro-e2e.test.js && node scripts/lancer-node.js tests/synchro-auto.test.js && node scripts/lancer-node.js tests/sauvegarde-fusion.test.js && node scripts/lancer-node.js tests/images-distantes.test.js && node scripts/lancer-node.js tests/journal-rapport.test.js",
    "postinstall": "node scripts/binaire-sqlite.js"
  },
  "dependencies": {
    "adm-zip": "^0.5.18",
    "better-sqlite3": "^11.7.0",
    "google-auth-library": "^9.15.0",
    "jimp": "^0.22.12"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/camera": "^8.2.4",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/network": "^8.0.1",
    "@capgo/capacitor-social-login": "^8.5.11",
    "@noble/hashes": "^2.4.0",
    "@vitejs/plugin-react": "^4.3.4",
    "astral-regex": "^2.0.0",
    "buffer": "^6.0.3",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "fflate": "^0.8.3",
    "path-browserify": "^1.0.1",
    "png-to-ico": "^3.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sql.js": "^1.14.2",
    "vite": "^6.0.7"
  },
  "build": {
    "appId": "fr.tuilesettoiles.app",
    "productName": "Tuiles et Toiles",
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "src/main/**",
      "dist/**",
      "package.json",
      "node_modules/**"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "extraResources": [
      {
        "from": "data/pack.db",
        "to": "data/pack.db"
      },
      {
        "from": "data/registre.json",
        "to": "data/registre.json"
      },
      {
        "from": "data/vignettes",
        "to": "data/vignettes"
      },
      {
        "from": "data/images-manifest.json",
        "to": "data/images-manifest.json"
      },
      {
        "from": "build/icon.ico",
        "to": "icone.ico"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Tuiles-et-Toiles-${version}.${ext}"
    },
    "portable": {
      "unpackDirName": "TuilesEtToiles-${version}",
      "requestExecutionLevel": "user"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": false,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Tuiles-et-Toiles-Setup-${version}.${ext}"
    }
  }
}
